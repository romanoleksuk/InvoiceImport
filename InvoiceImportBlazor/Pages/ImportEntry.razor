<div class="flex items-center justify-center min-h-screen bg-gray-50">
    <div class="max-w-2xl w-full mx-3 sm:mx-4">
        <div class="bg-white rounded-lg shadow-lg p-5 sm:p-8">
            <div class="text-center mb-6 sm:mb-8">
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">
                    Invoice Import
                </h1>
            </div>

            <div>
                <FileUpload OnFileUploaded="OnFileUploaded" IsProcessing="IsProcessing" />
            </div>
        </div>

        <div class="mt-6 text-center text-sm text-gray-500">
            <p>Need help? Contact support at support@example.com</p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<(byte[] data, string contentType)> OnFileUploaded { get; set; }

    [Parameter]
    public bool IsProcessing { get; set; }
}
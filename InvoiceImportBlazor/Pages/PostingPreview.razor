@using InvoiceImportBlazor.Models

<div class="h-full flex flex-col bg-white">
    <div class="p-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Posting Preview</h2>
    </div>

    <div class="flex-1 p-4 overflow-visible lg:overflow-auto">
        <div class="bg-white border border-gray-200 rounded-lg p-4 mb-4 shadow-sm">
            <h3 class="text-sm font-semibold text-gray-700 mb-4 uppercase">Exchange Rate</h3>

            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-600">USD Total:</span>
                    <span class="text-lg font-semibold text-gray-900">$@UsdTotal.ToString("N2")</span>
                </div>

                <div class="flex items-center gap-2">
                    <label class="text-sm text-gray-600 flex-shrink-0">Rate:</label>
                    <input
                        type="number"
                        step="0.0001"
                        value="@ExchangeRate"
                        @oninput="HandleExchangeRateInput"
                        disabled="@IsRateLocked"
                        class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm font-medium disabled:bg-gray-100 disabled:cursor-not-allowed w-full" />
                    <button
                        @onclick="OnLockRate"
                        class="@GetLockButtonClass()"
                        title="@(IsRateLocked ? "Rate locked" : "Lock rate")">
                        @(IsRateLocked ? "🔒" : "🔓")
                    </button>
                </div>

                <div class="pt-3 border-t border-gray-200">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600">CAD Total:</span>
                        <span class="text-xl font-bold text-blue-600">$@CadTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm mb-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-3 uppercase">Validation Status</h3>

            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <span class="text-lg">@(Validation.TotalsMatch ? "✅" : "❌")</span>
                    <span class="text-sm text-gray-700">
                        @(Validation.TotalsMatch ? "Totals match" : "Totals do not match")
                    </span>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-lg">@(!Validation.MissingCustomFields ? "✅" : "⚠️")</span>
                    <span class="text-sm text-gray-700">
                        @(!Validation.MissingCustomFields ? "All custom fields present" : "Missing custom field")
                    </span>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-lg">@(Validation.DistributionMatch ? "✅" : "❌")</span>
                    <div class="flex-1">
                        <div class="text-sm text-gray-700">
                            @(Validation.DistributionMatch
                                ? "CAD distribution matches header total"
                                : "CAD distribution does not match header total")
                        </div>
                        @if (!Validation.DistributionMatch)
                        {
                            <div class="text-xs text-gray-500 mt-1">
                                Distribution: $@CadDistributionTotal.ToString("N2") |
                                Header: $@CadTotal.ToString("N2") |
                                Diff: $@Math.Abs(CadTotal - CadDistributionTotal).ToString("N2")
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (ValidationResult != null)
        {
            <ValidationIssuesDisplay ValidationResult="ValidationResult" />
        }

        <div class="mt-6 space-y-2">
            <button
                @onclick="OnPostInvoice"
                disabled="@(!CanPost)"
                class="w-full bg-green-600 hover:bg-green-700 disabled:bg-gray-400 disabled:cursor-not-allowed text-white font-semibold py-2 px-4 rounded-md transition">
                Post Invoice
            </button>

            <div class="pt-2 border-t border-gray-200">
                <p class="text-xs font-semibold text-gray-600 mb-2">Export Options:</p>
                <div class="flex gap-2">
                    <button
                        @onclick="() => OnExport.InvokeAsync(ExportFormat.JSON)"
                        class="flex-1 bg-blue-100 hover:bg-blue-200 text-blue-700 text-sm font-medium py-2 px-3 rounded-md transition">
                        📄 JSON
                    </button>
                    <button
                        @onclick="() => OnExport.InvokeAsync(ExportFormat.CSV)"
                        class="flex-1 bg-green-100 hover:bg-green-200 text-green-700 text-sm font-medium py-2 px-3 rounded-md transition">
                        📊 CSV
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public decimal UsdTotal { get; set; }

    [Parameter]
    public decimal ExchangeRate { get; set; }

    [Parameter]
    public EventCallback<decimal> ExchangeRateChanged { get; set; }

    [Parameter]
    public EventCallback OnLockRate { get; set; }

    [Parameter]
    public EventCallback OnPostInvoice { get; set; }

    [Parameter]
    public EventCallback<string> OnExport { get; set; }

    [Parameter]
    public bool IsRateLocked { get; set; }

    [Parameter]
    public ValidationStatus Validation { get; set; } = new();

    [Parameter]
    public ValidationResult? ValidationResult { get; set; }

    [Parameter]
    public decimal CadDistributionTotal { get; set; }

    [Parameter]
    public bool CanPost { get; set; } = true;

    private decimal CadTotal => UsdTotal * ExchangeRate;

    private Task HandleExchangeRateInput(ChangeEventArgs args)
    {
        if (IsRateLocked)
        {
            return Task.CompletedTask;
        }

        if (decimal.TryParse(args.Value?.ToString(), out var newRate) && newRate > 0m)
        {
            return ExchangeRateChanged.InvokeAsync(newRate);
        }

        return Task.CompletedTask;
    }

    private string GetLockButtonClass()
    {
        return IsRateLocked
            ? "p-2 rounded-md transition bg-blue-100 text-blue-600 text-xs font-semibold"
            : "p-2 rounded-md transition bg-gray-100 text-gray-600 hover:bg-gray-200 text-xs font-semibold";
    }
}
